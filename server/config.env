# Config contract for the shopping-list server: every environment variable the app reads,
# declared with POSIX/Compose-spec parameter expansion. `${VAR:-default}` is optional;
# `${VAR:?message}` is required and fails the container at startup (via docker-entrypoint.sh) with
# that message if unset. No real secrets or per-deployment overrides belong here -- in production
# those live in the infra repo's hosts/apps/shopping-list/compose.yml. This repo never reads infra.

SHOPPING_LIST_DB=${SHOPPING_LIST_DB:-/data/shopping.db}
# "claude" shells out to the Claude Code CLI to sort new items into aisles; "none" leaves everything
# unknown in Uncategorized. Switching this to "claude" also makes CLAUDE_CODE_OAUTH_TOKEN required
# in practice, even though it has no default here -- this file can't express that conditional.
SHOPPING_LIST_CLASSIFIER=${SHOPPING_LIST_CLASSIFIER:-none}
CLAUDE_CODE_OAUTH_TOKEN=${CLAUDE_CODE_OAUTH_TOKEN:-}
CLAUDE_BIN=${CLAUDE_BIN:-claude}
SHOPPING_LIST_CLASSIFY_TIMEOUT=${SHOPPING_LIST_CLASSIFY_TIMEOUT:-30}

SHOPPING_LIST_FIRMWARE_DIR=${SHOPPING_LIST_FIRMWARE_DIR:-/data/firmware}
# The firmware version every device should be offered OTA; empty means no OTA is offered.
SHOPPING_LIST_FIRMWARE_VERSION=${SHOPPING_LIST_FIRMWARE_VERSION:-}
# IANA timezone the sync schedule's clock times are read in; empty means the server's own local time.
SHOPPING_LIST_TIMEZONE=${SHOPPING_LIST_TIMEZONE:-}

# OpenTelemetry is opt-in: leave the endpoint unset to disable it entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT:-}
OTEL_EXPORTER_OTLP_HEADERS=${OTEL_EXPORTER_OTLP_HEADERS:-}
OTEL_SDK_DISABLED=${OTEL_SDK_DISABLED:-}
